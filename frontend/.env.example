# URL base do backend Chamacarga (FastAPI)
# Local:      http://localhost:8000
# Produção:   https://chamacarga-api.onrender.com   (ajuste para a URL do seu serviço Render)
VITE_API_URL=http://localhost:8000

# Supabase Auth (Sprint 4). Sem essas duas, a UI de login degrada
# graciosamente e o app cai no fluxo legacy (JWT em localStorage).
# Pegue em: Supabase → Settings → API
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
