# Connection string do Supabase (Settings → Database). Em serverless, prefira o pooler (porta 6543).
DATABASE_URL=postgresql://postgres:<senha>@db.<projeto>.supabase.co:5432/postgres

# Segredo de assinatura do JWT do Supabase (Settings → API → JWT Secret).
# Obrigatório — o backend rejeita qualquer request sem Bearer válido.
SUPABASE_JWT_SECRET=troque-por-o-jwt-secret-do-seu-projeto

# Supabase Storage (Sprint 4 pt.3). Se ambos vazios, o endpoint de upload
# retorna 501 e o PWA motorista cai no fluxo legacy (data URL no /pod).
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # Settings → API → service_role (NÃO usar no front!)
STORAGE_BUCKET=pods
UPLOAD_MAX_MB=8

# Domínios autorizados a chamar a API. Em dev: http://localhost:5173
# '*' é rejeitado (não faz sentido junto com JWT). Separe múltiplos por vírgula.
CORS_ORIGINS=http://localhost:5173

# Token opcional para uso interno (simulador de logger, cron, backfill).
# Se preenchido, requests com "Authorization: Bearer <SERVICE_TOKEN>" bypassam
# o filtro por cliente_id. Deixe vazio em produção se não usar.
SERVICE_TOKEN=

# Chave da Anthropic (NÃO expor no front).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# URL pública do frontend — usada pra montar os links absolutos
# enviados ao destinatário via WhatsApp/SMS. Sem isso, o backend
# retorna URL relativa e não envia notificação (evita link quebrado).
PUBLIC_BASE_URL=https://chamacarga.vercel.app

# --- WhatsApp Business Cloud API (Meta) — opcional ---
# Sem os três abaixo preenchidos, o envio via WhatsApp fica off e cai
# no SMS fallback (se configurado).
WHATSAPP_TOKEN=EAA...                       # access token permanente
WHATSAPP_PHONE_ID=0000000000000000          # ID do número emissor
WHATSAPP_TEMPLATE_NAME=reserva_janela_pt_br # template pré-aprovado
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- SMS fallback (Zenvia) — opcional ---
SMS_PROVIDER=zenvia          # ou vazio pra desligar
SMS_API_KEY=xxxxxxxxxxxxxxx  # Zenvia → API keys
SMS_FROM=Chamacarga          # nome/número emissor
